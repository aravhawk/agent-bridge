{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "api/queue.mjs": {
      "maxDuration": 60,
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "jarvis-friday-bridge-v1", "maxDeliveries": 20 }]
    },
    "api/index.mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/((?!api/queue).*)", "destination": "/api/index" }
  ]
}
