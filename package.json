{
  "name": "agent-inbox-bridge",
  "version": "1.0.0",
  "description": "Self-hosted MCP inbox for an OpenAI dot and Grok Bot. Messages are data, never permission.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aravhawk/agent-bridge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "compile:check": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/check-emitted.ts dist",
    "check:remote": "python3 scripts/check_v1.py",
    "package:plugin": "python3 scripts/package_plugin.py"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "@vercel/queue": "0.10.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "standardwebhooks": "1.1.1"
  },
  "overrides": {
    "zod": "4.6.7",
    "minimatch": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
