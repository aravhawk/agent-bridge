{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agent-inbox-bridge": {
      "type": "streamable-http",
      "url": "{{RESOURCE}}",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "{{CLIENT_ID}}",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationServerBase": "{{OAUTH_ISSUER}}",
            "resource": "{{RESOURCE}}",
            "baseScopes": [
              "{{ACK_SCOPE}}",
              "{{SEND_SCOPE}}",
              "offline_access"
            ],
            "defaultScopes": [],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
