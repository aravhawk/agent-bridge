# Jarvis Friday Bridge v1.0.0. No credential belongs in this file.
# Obtain the exact issuer from the approved Clerk production instance and verify
# its metadata/JWKS. It must be a HTTPS origin under this service's namespace.
BRIDGE_OAUTH_ISSUER=
BRIDGE_OAUTH_CONTRACT_VERIFIED=false
BRIDGE_OAUTH_SCOPE_CLAIM=scope
BRIDGE_ALLOWED_SUBJECT_SHA256=
# Production-only Secret bindings on the NEW isolated v1 project.
DATABASE_URL=
FRIDAY_WEBHOOK_URL=
FRIDAY_WEBHOOK_KEY=
BRIDGE_SUBSCRIPTION_STORAGE_KEY=
# Setup/delivery are independent. All remain closed until actual verification.
BRIDGE_SUBSCRIPTIONS_ENABLED=false
BRIDGE_DELIVERY_ENABLED=false
BRIDGE_RECEIVER_POLICY=
FRIDAY_RECEIVER_ID=jarvis-friday-bridge-inbox
FRIDAY_WEBHOOK_CONTRACT_VERIFIED=false
