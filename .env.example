# Agent Inbox Bridge v1.0.0. No credential belongs in this file; store every
# value in your platform's secret store. Reference: docs/configuration.md

# --- Deployment identity (read at startup) ---------------------------------
# Leaving BRIDGE_PUBLIC_ORIGIN unset selects compatibility mode for the original
# deployment. New deployments must set both of these.
BRIDGE_PUBLIC_ORIGIN=https://bridge.example.com
BRIDGE_PEERS=alice:events,bob:webhook
# Optional display label in /health and OAuth resource metadata (1-64 printable
# ASCII characters). It does not rename peers, routes, audiences or protocol IDs.
# BRIDGE_SERVICE_NAME=My Assistant Bridge
# Optional: BRIDGE_MESSAGE_PROTOCOL, BRIDGE_RECEIVER_ID,
# BRIDGE_QUEUE_TOPIC (must match vercel.json), BRIDGE_QUEUE_REGION,
# BRIDGE_REQUIRE_ISSUER_UNDER_ORIGIN, BRIDGE_DATABASE_HOST_SUFFIX

# --- OAuth provider (resource-server verification only) --------------------
# Exact HTTPS issuer origin from your provider's metadata, e.g. a Clerk
# production instance. JWKS is fetched from <issuer>/.well-known/jwks.json.
BRIDGE_OAUTH_ISSUER=
BRIDGE_OAUTH_SCOPE_CLAIM=scope
# SHA-256 hex of the single allowed token subject (or set BRIDGE_ALLOWED_SUBJECT).
BRIDGE_ALLOWED_SUBJECT_SHA256=
BRIDGE_OAUTH_CONTRACT_VERIFIED=false

# --- Storage ---------------------------------------------------------------
# postgres(ql):// URL with sslmode=require or verify-full.
DATABASE_URL=
# 32 random bytes, base64: openssl rand -base64 32
BRIDGE_SUBSCRIPTION_STORAGE_KEY=

# --- Readiness gates (all closed until verified) ---------------------------
BRIDGE_SUBSCRIPTIONS_ENABLED=false
BRIDGE_DELIVERY_ENABLED=false
BRIDGE_RECEIVER_POLICY=

# --- Wake/sync delivery classes (optional, default off) ------------------
# Comma-separated recipient peer IDs, e.g. bob. Empty keeps v1 behavior.
BRIDGE_WAKE_SYNC_RECIPIENTS=
# Scheduled trigger for /api/cron (see docs/scheduler.md). Either or both:
# QStash (selected): its signing keys, plus the exact public destination URL
# the schedule targets (https://<host>/api/cron). Unset: signed calls refused.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
BRIDGE_QSTASH_DESTINATION_URL=
# Any other scheduler: a bearer secret (16+ random characters).
CRON_SECRET=

# --- Private file transfer (optional, default off) --------------------------
# Private Vercel Blob store connected to this project; intended auth is OIDC.
# The SDK has a static-token fallback when OIDC is absent; do not configure it.
# BLOB_STORE_ID is an identifier, not a credential. See docs/attachments.md.
# Nothing is ever deleted by the bridge without an approved retention policy.
BRIDGE_ATTACHMENTS_ENABLED=false
# Per-file maximum in decimal bytes, 500000000 (default) to 1000000000.
BRIDGE_ATTACHMENT_MAX_BYTES=
BLOB_STORE_ID=

# --- Webhook peer (prefix BRIDGE_PEER_<ID>_, here ID=bob) -------------------
BRIDGE_PEER_BOB_WEBHOOK_URL=
# whsec_<base64> Standard Webhooks secret (or set ..._WEBHOOK_AUTH=bearer).
BRIDGE_PEER_BOB_WEBHOOK_SECRET=
BRIDGE_PEER_BOB_RECEIVER_ID=agent-inbox-bridge
BRIDGE_PEER_BOB_WEBHOOK_CONTRACT_VERIFIED=false
# One-time diagnostic window (ISO start/end, at most 2h).
BRIDGE_PEER_BOB_DIAGNOSTIC_FROM=
BRIDGE_PEER_BOB_DIAGNOSTIC_UNTIL=
# One stored-message canary (fresh UUID, return sub_..., at most 30m).
BRIDGE_PEER_BOB_CANARY_MESSAGE_ID=
BRIDGE_PEER_BOB_CANARY_RETURN_SUBSCRIPTION_ID=
BRIDGE_PEER_BOB_CANARY_FROM=
BRIDGE_PEER_BOB_CANARY_UNTIL=
