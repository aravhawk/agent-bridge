# Nonsecret configuration; values must come from the isolated approved provider.
CLERK_ISSUER=https://musical-bee-9978.clerk.accounts.dev
CLERK_JWKS_URL=https://musical-bee-9978.clerk.accounts.dev/.well-known/jwks.json
# Public client IDs are documented in docs/configuration.md and plugin/mcp.json.
FRIDAY_OAUTH_CLIENT_ID=
JARVIS_OAUTH_CLIENT_ID=
BRIDGE_ALLOWED_SUBJECT=
# A pinned SHA256 subject digest may be supplied instead; never configure both.
BRIDGE_ALLOWED_SUBJECT_SHA256=
BRIDGE_OAUTH_SCOPE_CLAIM=scope
BRIDGE_AUTH_DIAGNOSTIC=false
BRIDGE_AUTH_TIMING_DIAGNOSTIC=false
BRIDGE_RPC_SHAPE_DIAGNOSTIC=false
# These values belong only in Vercel project-level Production Secret storage.
# Never paste their real values into this file or chat.
DATABASE_URL=
FRIDAY_WEBHOOK_URL=
FRIDAY_WEBHOOK_KEY=
# Required for AES-GCM protection of native Events callback configuration.
# Supplied through approved Secret storage only.
BRIDGE_SUBSCRIPTION_STORAGE_KEY=
# Nonsecret, operator-only finite test configuration. Blank keeps delivery off.
FRIDAY_RECEIVER_ID=
FRIDAY_TEST_AUTHORIZED_UNTIL=
FRIDAY_WEBHOOK_CONTRACT_VERIFIED=false
FRIDAY_CONTRACT_PROBE_MESSAGE_ID=
# Pin remains mandatory after transport verification. Sender selects one leg.
BRIDGE_TEST_PROBE_SENDER=jarvis
# Example remains closed by default. Both native OAuth connections are verified;
# native refresh, renewal and hosted wake still require independent evidence.
BRIDGE_OAUTH_CONTRACT_VERIFIED=false
BRIDGE_SUBSCRIPTIONS_ENABLED=false
BRIDGE_DELIVERY_ENABLED=false
# Native OpenAI callback configuration comes only from authenticated subscription
# handshake; never ask the user for a Sites token or generic Jarvis REST URL.

# Daily-use candidate remains off until independent review and both native inbox
# policies are saved and verified. No new OAuth scope or secret is introduced.
BRIDGE_DAILY_ENABLED=false
BRIDGE_DAILY_RECEIVER_POLICY=
# Exact reviewed attestation: inbox-v1. Global delivery and verified Friday
# transport remain separate requirements. Keep DAILY_ENABLED true during a
# delivery shutdown so already reserved backend retention callbacks can finish.
